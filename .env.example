# Free-tier Gemini model for structured extraction and verification reasoning.
# Create a key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Automatic fallbacks for temporary 503/high-demand errors.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash

# Optional Tavily API key. Keys normally begin with "tvly-".
# If omitted, the tracker uses Tavily keyless search/extract mode with its shared free rate limit.
TAVILY_API_KEY=

# Optional. Change if you want the SQLite DB elsewhere.
DATABASE_PATH=data/competitions.db
